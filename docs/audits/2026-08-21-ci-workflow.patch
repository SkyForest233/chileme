diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -41,8 +41,30 @@ jobs:
           RELEASE_KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
           RELEASE_KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
           RELEASE_KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
+          # versionCode 必须单调递增，否则系统视为同一版本、无法覆盖升级。
+          # run_number 在仓库维度单调递增，天然满足。
+          APP_VERSION_CODE: ${{ github.run_number }}
+          # tag 构建取 tag 名（build.gradle.kts 会剥掉前导 v）；手动跑分支时为分支名，
+          # 此时不作为版本名使用，交由 build 脚本回落 "1.0"。
+          APP_VERSION_NAME: ${{ startsWith(github.ref, 'refs/tags/v') && github.ref_name || '' }}
         run: ./gradlew assembleRelease
 
+      # 防回归：确认产物不是 debug 签名。build.gradle.kts 已在凭据缺失时直接失败，
+      # 这里再从产物侧兜一道，防止未来有人重新引入静默降级。
+      - name: Verify release signature
+        run: |
+          set -euo pipefail
+          APK=$(find app/build/outputs/apk/release -name '*.apk' | head -1)
+          echo "Verifying $APK"
+          SDK="${ANDROID_HOME:-${ANDROID_SDK_ROOT:-}}"
+          APKSIGNER=$(find "$SDK/build-tools" -name apksigner | sort -V | tail -1)
+          CERTS=$("$APKSIGNER" verify --print-certs "$APK")
+          echo "$CERTS"
+          if echo "$CERTS" | grep -q "CN=Android Debug"; then
+            echo "::error::Release APK 使用了 debug 签名，拒绝发布。"
+            exit 1
+          fi
