<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 非 Animatable 图标会 108dp 预渲染再放大，高分屏发糊。
  外层 AnimationDrawable = Animatable，走全尺寸绘制。
  内层必须是自适应图标：foreground PNG 自带米色方画布，直接当 splash 会在暗色底上露出很方的圆角矩形。
-->
<animation-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:oneshot="true">
    <item
        android:drawable="@mipmap/ic_launcher"
        android:duration="1" />
</animation-list>
