<?xml version="1.0" encoding="utf-8"?>
<!--
  FileProvider 可授权范围。只暴露实际需要共享的两个子目录，
  而非整个 cacheDir / filesDir（此前是 path="."，等于把包含 DataStore、
  损坏数据留档在内的全部私有文件都纳入可授权范围）。

  - camera/：拍照临时文件（EditFoodScreen 写入后交给相机应用）
  - covers/：封面图（ImageStore.copyImageToCovers 落盘位置）
-->
<paths>
    <cache-path name="camera" path="camera/" />
    <files-path name="covers" path="covers/" />
</paths>
