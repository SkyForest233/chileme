<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 的备份/迁移规则（android:dataExtractionRules）。
  理由同 backup_rules.xml：Keystore 密文不跨设备，备份过去也解不开。

  cloud-backup 与 device-transfer 分别对应「云备份」与「换机直传」两条通道，
  两者都排除 DataStore，避免恢复出无法使用的凭据。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="covers/" />
        <exclude domain="file" path="corrupt/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="file" path="corrupt/" />
    </device-transfer>
</data-extraction-rules>
